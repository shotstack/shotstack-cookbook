# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders. Then use your sandbox key.
SHOTSTACK_ENV=

# Your AI provider's OpenAI-compatible API, for example https://api.openai.com/v1
# The README lists the values for OpenAI, Anthropic and Google Gemini.
AI_BASE_URL=

# Your API key for that provider, for example from https://platform.openai.com/api-keys
AI_API_KEY=

# The model that picks the moments, for example gpt-5.4-mini
AI_MODEL=
