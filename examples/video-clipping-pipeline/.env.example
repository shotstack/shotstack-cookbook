# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders. Then use your sandbox key.
SHOTSTACK_ENV=

# The OpenAI-compatible API of your AI provider. The README gives the URL for each provider.
AI_BASE_URL=

# Your API key for that provider. The README gives the page where you get it.
AI_API_KEY=

# The model that picks the moments, for example gpt-5.4-mini
AI_MODEL=
