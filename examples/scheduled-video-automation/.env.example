# Production API key. Both keys are in the dashboard under API Keys.
# https://dashboard.shotstack.io/register
SHOTSTACK_API_KEY=

# The id that the template request in the README returns.
# https://shotstack.io/docs/api/#tag/Edit/operation/postTemplate
SHOTSTACK_TEMPLATE_ID=

# Optional. HTTPS URL of a JSON feed. Leave empty to read feed.json.
FEED_URL=

# Only for Step 5 of the guide. Generate with the command in the README.
WEBHOOK_SECRET=

# Only for Step 5 of the guide. Public HTTPS URL that reaches webhook.mjs.
CALLBACK_URL=
