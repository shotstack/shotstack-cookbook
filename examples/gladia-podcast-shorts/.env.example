# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Your Gladia API key: https://app.gladia.io
GLADIA_API_KEY=

# A public link to the recording you want to cut up
AUDIO_URL=

# Optional. Topics the clips should cover, separated by commas.
KEYWORDS=

# Optional. A public video to play behind the captions.
BACKGROUND_URL=

# Optional. How many clips, and how long each one can be.
CLIP_COUNT=
CLIP_SECONDS=

# Optional. Set to stage for free watermarked test renders.
SHOTSTACK_ENV=
